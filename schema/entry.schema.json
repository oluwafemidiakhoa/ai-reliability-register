{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-reliability-register:schema:entry:1.0.0",
  "title": "AI Reliability Claims Register entry",
  "description": "One audit of one published AI reliability claim, in two stages. The sealed stage is written and hashed before the audit starts; the open stage is filled in afterwards. The seal hash covers the auditor and the sealed block (see README, 'How the seal works'). Numbers in the sealed block are integers only, so the canonical form is identical in every language.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "auditor", "sealed", "open"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "auditor": {
      "description": "Sealed and open stages: who ran the audit. Part of the seal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "orcid", "self_audit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "orcid": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$" },
        "self_audit": { "type": "boolean", "description": "True when the auditor built or operates the audited system." }
      }
    },
    "sealed": {
      "description": "Written before the audit starts. Never edited after sealing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "claim", "checks", "prediction", "confidence", "sealed_at", "seal_hash"],
      "properties": {
        "id": { "type": "string", "pattern": "^REG-[0-9]{4}-[0-9]{3}$" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "version": { "type": "string", "minLength": 1, "description": "Commit, release, record DOI or date that identifies exactly what was audited." },
            "owner": { "type": "string" }
          }
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "source", "location"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "description": "The published claim, quoted exactly." },
            "source": { "type": "string", "pattern": "^https://" },
            "location": { "type": "string", "minLength": 1, "description": "Where in the source the quote appears (section, line, page)." }
          }
        },
        "checks": {
          "description": "Protocol checks the audit will run (IDs from the protocol: T1-T6, C1-C4, N1-N3, S1-S4).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(T[1-6]|C[1-4]|N[1-3]|S[1-4])$" }
        },
        "prediction": {
          "description": "What the auditor expects the audit to find, written before it starts. Null only for entries recorded retrospectively.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "confidence": {
          "description": "Auditor's confidence in the prediction, as an integer percentage. Null exactly when prediction is null.",
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "sealed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "seal_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "open": {
      "description": "Filled in after the audit. Null fields mean 'not yet'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "outcome", "cost", "author_contacted", "published_at"],
      "properties": {
        "result": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["summary", "findings"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "checks", "finding", "class"],
                "properties": {
                  "id": { "type": "string", "pattern": "^F[0-9]+$" },
                  "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(T[1-6]|C[1-4]|N[1-3]|S[1-4])$" } },
                  "finding": { "type": "string", "minLength": 1 },
                  "class": { "enum": ["measurement", "omission", "framing", "none"] }
                }
              }
            },
            "not_performed": {
              "description": "Checks that were planned or applicable but not done, each with the reason.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "report": { "type": "string", "pattern": "^https://", "description": "Where the full audit is published." }
          }
        },
        "outcome": {
          "description": "claim_holds / claim_partly_holds / claim_fails / inconclusive / not_reproducible, or null while the audit is open.",
          "enum": ["claim_holds", "claim_partly_holds", "claim_fails", "inconclusive", "not_reproducible", null]
        },
        "cost": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["api_usd", "note"],
          "properties": {
            "api_usd": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]{2}$", "description": "Paid API spend, as a decimal string." },
            "note": { "type": "string" }
          }
        },
        "author_contacted": {
          "description": "Date the target's author was first contacted (YYYY-MM-DD), false if not yet, or null when there is nobody to contact (self-audit).",
          "type": ["string", "boolean", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "published_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "notes": {
      "description": "Context that is not part of either stage and not covered by the seal.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
